# Docker/Dockerfile.klee
#
# Builds a reproducible KLEE + LLVM 13 + Z3 toolchain image.
#
# NOTE: this build was authored and syntax-reviewed in a sandboxed dev
# environment without Docker/full network egress (see docs/PHASE1_NOTES.md).
# Build and verify it on your own machine or CI before relying on it:
#
#   docker build -f Docker/Dockerfile.klee -t adaptive-sym-exec/klee-env .
#   docker run --rm adaptive-sym-exec/klee-env klee --version
#
# Versions are pinned deliberately for reproducibility (a paper artifact
# should not silently pick up a newer KLEE/LLVM at build time).

FROM ubuntu:22.04 AS builder

ARG LLVM_VERSION=13
ARG KLEE_VERSION=3.0
ARG KLEE_UCLIBC_VERSION=klee_uclibc_v1.2

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        curl \
        python3 \
        python3-pip \
        libsqlite3-dev \
        libcap-dev \
        libboost-all-dev \
        perl \
        zlib1g-dev \
        libtinfo-dev \
        libz3-dev \
        z3 \
        wget \
        gcc-multilib \
        g++-multilib \
        bison \
        flex \
        libglib2.0-dev \
        && rm -rf /var/lib/apt/lists/*

# ---- LLVM ------------------------------------------------------------
RUN wget -q https://apt.llvm.org/llvm.sh -O /tmp/llvm.sh \
    && chmod +x /tmp/llvm.sh \
    && /tmp/llvm.sh ${LLVM_VERSION}

# ---- klee-uclibc (musl-free libc for symbolic execution) --------------
RUN git clone --depth 1 -b ${KLEE_UCLIBC_VERSION} \
        https://github.com/klee/klee-uclibc.git /opt/klee-uclibc \
    && cd /opt/klee-uclibc \
    && ./configure --make-llvm-lib \
        --with-llvm-config=/usr/lib/llvm-${LLVM_VERSION}/bin/llvm-config \
    && make -j"$(nproc)"

# ---- KLEE ---------------------------------------------------------------
RUN git clone --depth 1 -b v${KLEE_VERSION} \
        https://github.com/klee/klee.git /opt/klee-src

RUN mkdir -p /opt/klee-build && cd /opt/klee-build \
    && cmake -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLVM_CONFIG_BINARY=/usr/lib/llvm-${LLVM_VERSION}/bin/llvm-config \
        -DENABLE_SOLVER_Z3=ON \
        -DENABLE_SOLVER_STP=OFF \
        -DENABLE_POSIX_RUNTIME=ON \
        -DENABLE_KLEE_UCLIBC=ON \
        -DKLEE_UCLIBC_PATH=/opt/klee-uclibc \
        -DENABLE_UNIT_TESTS=OFF \
        -DENABLE_SYSTEM_TESTS=OFF \
        /opt/klee-src \
    && ninja \
    && ninja install

# ---------------------------------------------------------------------
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        libz3-4 \
        libsqlite3-0 \
        libtinfo6 \
        python3 \
        python3-pip \
        && rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local /usr/local
COPY --from=builder /usr/lib/llvm-13 /usr/lib/llvm-13
ENV PATH="/usr/local/bin:/usr/lib/llvm-13/bin:${PATH}"

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["klee --version"]
