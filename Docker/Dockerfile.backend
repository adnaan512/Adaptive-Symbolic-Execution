# Docker/Dockerfile.backend
#
# Python side: FastAPI backend, feature extraction, ML ranking, LLM client,
# RL training loop. Deliberately does NOT include the KLEE/LLVM toolchain —
# that lives in Dockerfile.klee. The backend calls into a klee-env container
# (or a shared volume + subprocess) rather than bundling both toolchains in
# one heavy image.

FROM python:3.11-slim AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
